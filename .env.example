# ══════════════════════════════════════════════════════════════════════════════
# .env.example — Copy to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════════════

# ── LiveKit Cloud ───────────────────────────────────────────────────────────
# Get from: https://cloud.livekit.io/ → your project → Settings
LIVEKIT_URL=wss://avatar-dhrg89cz.livekit.cloud
LIVEKIT_API_KEY=APIm6yBF5DiHwLF
LIVEKIT_API_SECRET=faBL0UaOBxElKj8rSJadeL1KXa4ax2zVbBkJRcK78fcB

# ── OpenAI (LLM) ────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyDCc639rjzXZhK82M0xVuBPR1u0oFmixQw

# ── Sarvam AI (STT + TTS) ───────────────────────────────────────────────────
# Get from: https://app.sarvam.ai/
SARVAM_API_KEY=sk_6du1vdqn_fTzfvwOJS7RxHy2yKjUitjb5

# ── Cal.com (Booking) ───────────────────────────────────────────────────────
# Get from: https://app.cal.com/settings/developer/api-keys
CAL_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CAL_EVENT_TYPE_ID=1234567

# ── Supabase (Database) ─────────────────────────────────────────────────────
# Get from: https://app.supabase.com/ → your project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── Supabase S3 (Call Recordings) ───────────────────────────────────────────
# Get from: Supabase Dashboard → Storage → Settings → S3 Access → Generate key
# Bucket: create a private bucket named 'call-recordings' in Storage
SUPABASE_S3_ACCESS_KEY=your_supabase_s3_access_key_id
SUPABASE_S3_SECRET_KEY=your_supabase_s3_secret_access_key
SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1

# ── Telegram Notifications ──────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram, then get your Chat ID
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ── SIP / VoBiz (optional) ──────────────────────────────────────────────────
VOBIZ_SIP_DOMAIN=your_sip_domain.sip.vobiz.ai
VOBIZ_USERNAME=your_username
VOBIZ_PASSWORD=your_password
VOBIZ_OUTBOUND_NUMBER=+91XXXXXXXXXX

# ── Call Transfer ────────────────────────────────────────────────────────────
# Phone number to transfer calls to (human agent fallback)
DEFAULT_TRANSFER_NUMBER=+91XXXXXXXXXX

# ═══════════════════════════════════════════════════════════════════════════════
# LOW LATENCY SERVICES (Deepgram + Azure - Recommended for Production)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Deepgram (Fast STT) ──────────────────────────────────────────────────────
# Sign up: https://console.deepgram.com/ → Create API Key
# Key format: 40-character alphanumeric string (no 'dg_' prefix in actual key)
# Benefits: ~300ms latency, excellent accuracy, streaming support
DEEPGRAM_API_KEY=0123456789abcdef0123456789abcdef01234567

# ── Azure Speech Services (Fast TTS with Indian Voices) ───────────────────────
# Sign up: https://azure.microsoft.com/en-us/products/ai-services/speech-to-text
# Create Speech resource → Keys and Endpoint → Copy KEY 1
# Key format: 32-character hex string
# Set region to "centralindia" for lowest latency from India
AZURE_SPEECH_KEY=0123456789abcdef0123456789abcdef
AZURE_SPEECH_REGION=centralindia
# Available Indian voices: en-IN-NeerjaNeural, en-IN-PriyaNeural, hi-IN-SwaraNeural
